import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        String str=s.nextLine();
        for(int i=0;i<str.length();i++){
            int pos=i+1,c=0;
            for(int j=2;j<pos;j++){
                if(pos%j==0){
                    c++;
                }
            }
            if(c==0){
                if(i==0){
                    continue;
                }
                else{
                System.out.print(str.charAt(i));
                } 
            }
        }
    }
}

import java.util.*;
public class SumSubArrayZero{
    public static void main(String args[]){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        int a[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=s.nextInt();
        }
        for(int i=0;i<n-1;i++){
            int sum=0;
            for(int j=i;j<n;j++){
                sum+=a[j];
                if(sum==0){
                    for(int k=i;k<=j;k++){
                        System.out.print(a[k]+" ");
                    }
                    System.out.println();
                }
            }
        }
    }
}

import java.util.*;
public class PassWord{
public static int CheckPassword(String st){
    if(st.length()<4){
        return 0;
    }
    if(st.charAt(0)>=48&&st.charAt(0)<=57){
        return 0;
    }
    int n=0,c=0;
    for(int i=0;i<st.length();i++){
        char ch=st.charAt(i);
        if(st.charAt(i)>=48&&st.charAt(i)<=57){
            n++;
        }
        if(ch>=65&&ch<=90){
            c++;
        }
        if(ch==47||ch==32){
            return 0;
        }
        
    }
    if(n>=1&&c>=1){
        return 1;
    }
  return 0;
}

    public static void main(String args[]){
        Scanner s=new Scanner(System.in);
        String st=s.next();
       System.out.print(CheckPassword(st));
    }
}

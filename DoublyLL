import java.util.*;
public class Doubly{
    public static Node head,tail;
    public static class Node{
        int d;
        Node next;
        Node pre;
        Node(int d){
            this.d=d;
        }
    }
    public static void InsertBeg(int x){
        Node n=new Node(x);
        if(head==null){
            head=tail=n;
            return;
        }
        n.next=head;
        head.pre=n;
        head=n;
    }
    public static void InsertPos(int x,int p){
        Node n=new Node(x);
        Node temp=head;
        Node prev=null;
        int i=1;
        while(i<p&&temp.next!=null){
            prev=temp;
            temp=temp.next;
            i++;
        }
        prev.next=n;
        n.pre=prev;
       n.next=temp;
       temp.pre=n;
    }
     public static void InsertEnd(int x){
         Node n=new Node(x);
         tail.next=n;
         n.pre=tail;
         tail=n;
     }   
    public static void displayf(){
        Node temp=head;
        while(temp!=null){
            System.out.print(temp.d+" ");
            temp=temp.next;
        }
        System.out.println();
    }
    public static void displayb(){
        Node temp=tail;
        while(temp!=null){
            System.out.print(temp.d+" ");
            temp=temp.pre;
        }
       System.out.println(); 
    }
    public static void deleteBeg(){
        head=head.next;
        head.pre=null;
    }
    public static void deletePos(int p){
        int i=1;
        Node temp=head;
        Node prev=null;
        while(i<p&&temp.next!=null){
            prev=temp;
            temp=temp.next;
            i++;
        }
      prev.next=temp.next;
      temp.next.pre=prev;
    }
    public static void deleteEnd(){
       tail=tail.pre;
       tail.next=null;
    }
    public static void main(String args[]){
        Scanner s=new Scanner(System.in);
        while(true){
            System.out.println("1.Insert at Begining\n2.Insert at Position\n3.Insert at end\n4.Delete at Begining\n5.Delete at position\n6.Delete at End\n7.Display forward\n8.Display backward");
            System.out.println("Enter your choice:");
            int ch=s.nextInt();
            if(ch==1){
                System.out.println("Enter the element:");
                int x=s.nextInt();
                InsertBeg(x);
            }
            else if(ch==2){
                System.out.println("Enter the element:");
                int x=s.nextInt();
                System.out.println("Enter the position:");
                int p=s.nextInt();
                InsertPos(x,p);
                
            }
           else if(ch==3){
               System.out.println("Enter the element:");
               int x=s.nextInt();
               InsertEnd(x);
           } 
           else if(ch==4){
               deleteBeg();
           }
           else if(ch==5){
               System.out.println("Enter the position:");
               int p=s.nextInt();
               deletePos(p);
           }
           else if(ch==6){
               deleteEnd();
           }
           else if(ch==7){
               displayf();
           }
           else if(ch==8){
               displayb();
           }
        }
        
    }
}

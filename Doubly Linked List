import java.util.*;
public class DoublyLinkedList{
    public static Node head,tail;
    public static class Node{
        int d;
        Node pre;
        Node next;
        Node(int d){
            this.d=d;
        }
    }
    public static void displayf(){
        Node temp=head;
        while(temp!=null){
            System.out.print(temp.d+" ");
            temp=temp.next;
        }
        System.out.println();
    }
    public static void  displayb(){
        Node temp=tail;
        while(temp!=null){
           System.out.print(temp.d+" ");
           temp=temp.pre;
        }
        System.out.println();
    }
    public static void insertBeg(int x){
        
        Node n=new Node(x);
        if(head==null){
            head=tail=n;
        
        }
        else{
        n.next=head;
        head.pre=n;
        head=n;
        }
        
    }
    public static void insertPos(int x,int p){
        Node n=new Node(x);
        Node temp=head;
        Node prev=null;
        
        int i=1;
        while(temp!=null&&i<p){
            prev=temp;
            temp=temp.next;
            i++;
        }
        if(temp!=null){
            prev.next=n;
            n.pre=prev;
            temp.pre=n;
           n.next=temp; 
        }
    }
    public static void insertLast(int x){
        Node n=new Node(x);
        tail.next=n;
        n.pre=tail;
        tail=n;
    }
    public static void deleteBeg(){
        head=head.next;
        head.pre=null;
    }
    public static void deletePos(int p){
        int i=1;
        Node temp=head;
        Node prev=null;
        while(temp!=null&&i<p){
            prev=temp;
            temp=temp.next;
            i++;
        }
        prev.next=temp.next;
        temp.next.pre=prev;
        
    }
    public static void deleteLast(){
        tail=tail.pre;
        tail.next=null;
    }
    public static void main(String args[]){
        Scanner s=new Scanner(System.in);
       while(true){
           for(;;){
System.out.println("1.Insert at begining\n2.Insert at position\n3.Insert at Last\n4.Display forward\n5.Display backward\n6.Delete at begining\n7.Delete at position\n8.Delete at last\n9.Exit");
               System.out.println("Enter the choice");
               int ch=s.nextInt();
               if(ch==1){
                   System.out.print("Enter the element:");
              
               int x=s.nextInt();
             insertBeg(x);
               }
               else if(ch==2){
                   System.out.println("Enter the element");
                   int x=s.nextInt();
                   System.out.println("Enter the position");
                   int p=s.nextInt();
                   insertPos(x,p);
               }
               else if(ch==3){
                   System.out.println("Enter the element:");
                   int x=s.nextInt();
                   insertLast(x);
               }
               else if(ch==4){
                   displayf();
               }
               else if(ch==5){
                   displayb();
               }
               else if(ch==6){
                   deleteBeg();
               }
               else if(ch==7){
                   System.out.println("Enter the position:");
                   int p=s.nextInt();
                   deletePos(p);
               }
               else if(ch==8){
                   deleteLast();
               }
              else if(ch==9){
                  break;
              } 
           }
       }
       
    }
    
}

import java.util.*;
public class SumSubArray{
public static void main(String[] args){
Scanner s=new Scanner(System.in);
int n=s.nextInt();
int a[]=new int[n];
for(int i=0;i<n;i++){
a[i]=s.nextInt();
}
int rs=0;
for(int i=0;i<n;i++){
rs+=a[i];
}
int ls=0,i=0;
for(i=0;i<n;i++){
rs=rs-a[i];
ls=ls+a[i];
if(ls==rs){
break;
}
}
if(i==n){
return ;
}
for(int k=0;k<=i;k++){
System.out.print([k]+" ");
}
System.out.println();
for(int k=i+1;k<n;k++){
System.out.print(a[k]+" ");
}
}
}
